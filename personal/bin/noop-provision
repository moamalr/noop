#!/usr/bin/env bash
# Create or renew the development profiles noop-install signs with.
#
# The real app is compiled in CI without signing, so Xcode never sees it. This builds a throwaway
# two-target stub (app + widget extension) carrying NOOP's bundle ids and entitlements, which makes
# Xcode's automatic signing register the App IDs, enable HealthKit, create the App Group, and
# download profiles covering every registered device. Re-run it after registering a new device, or
# when the profiles approach their yearly expiry. Needs Xcode signed in to the team's Apple ID
# (Xcode > Settings > Accounts).
#
# Usage: noop-provision
set -euo pipefail
. "$(dirname "$0")/_lib.sh"

STUB="$(mktemp -d -t noop-provision)"
trap 'rm -rf "$STUB"' EXIT
mkdir -p "$STUB/App" "$STUB/Widget"

cat > "$STUB/project.yml" <<EOF
name: NoopSigningStub
settings:
  base:
    DEVELOPMENT_TEAM: $DEVELOPMENT_TEAM
    CODE_SIGN_STYLE: Automatic
    COMPILER_INDEX_STORE_ENABLE: NO
targets:
  StubApp:
    type: application
    platform: iOS
    deploymentTarget: "17.0"
    sources: [App]
    info:
      path: App/Info.plist
      properties:
        UILaunchScreen: {}
    entitlements:
      path: App/App.entitlements
      properties:
        com.apple.developer.healthkit: true
        com.apple.developer.healthkit.background-delivery: true
        com.apple.developer.healthkit.access: []
        com.apple.security.application-groups: [$APP_GROUP_ID]
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: $APP_BUNDLE_ID
    dependencies:
      - target: StubWidget
  StubWidget:
    type: app-extension
    platform: iOS
    deploymentTarget: "17.0"
    sources: [Widget]
    info:
      path: Widget/Info.plist
      properties:
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
    entitlements:
      path: Widget/Widget.entitlements
      properties:
        com.apple.security.application-groups: [$APP_GROUP_ID]
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: $WIDGET_BUNDLE_ID
EOF

cat > "$STUB/App/App.swift" <<'EOF'
import SwiftUI
@main struct StubApp: App { var body: some Scene { WindowGroup { Text("stub") } } }
EOF

cat > "$STUB/Widget/Widget.swift" <<'EOF'
import SwiftUI
import WidgetKit
struct StubEntry: TimelineEntry { let date: Date }
struct StubProvider: TimelineProvider {
    func placeholder(in context: Context) -> StubEntry { StubEntry(date: .now) }
    func getSnapshot(in context: Context, completion: @escaping (StubEntry) -> Void) { completion(StubEntry(date: .now)) }
    func getTimeline(in context: Context, completion: @escaping (Timeline<StubEntry>) -> Void) {
        completion(Timeline(entries: [StubEntry(date: .now)], policy: .never))
    }
}
@main struct StubWidget: Widget {
    var body: some WidgetConfiguration {
        StaticConfiguration(kind: "stub", provider: StubProvider()) { _ in Text("stub") }
    }
}
EOF

(cd "$STUB" && xcodegen generate --quiet)
log "registering $APP_BUNDLE_ID, $WIDGET_BUNDLE_ID and $APP_GROUP_ID for team $DEVELOPMENT_TEAM"
if ! xcodebuild -project "$STUB/NoopSigningStub.xcodeproj" -scheme StubApp -configuration Release \
    -destination 'generic/platform=iOS' -derivedDataPath "$STUB/dd" -allowProvisioningUpdates build \
    > "$STUB/build.log" 2>&1; then
  grep -E 'error:' "$STUB/build.log" | sort -u >&2
  die "provisioning failed (is Xcode signed in under Settings > Accounts?)"
fi
log "profiles ready in ~/Library/Developer/Xcode/UserData/Provisioning Profiles"
